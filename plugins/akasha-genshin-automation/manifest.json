  "distribution": {
    "type": "release",
    "tag": "akasha-genshin-automation-v0.5.1",
    "asset": "akasha-genshin-automation-0.5.1-win-x64.zip",
    "size": 68807305,
    "sha256": "4fc740c5962c28fc4d549f8ac49d3960f2c505cfc49a56e58f36134a45da03c7"
  },
  "backend": {
    "type": "companion-process",
    "entry": "runtime/AkashaAutomation.Worker.exe",
    "protocolVersion": 1,
    "lifetime": "plugin",
    "integrityLevel": "inherit",
    "shutdownTimeoutMs": 5000
  }
}
