{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ColinXHL/akasha-plugins/schemas/plugin-resources.schema.json",
  "title": "Akasha Plugin Resource Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "pluginId",
    "resources"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "pluginId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 100
    },
    "resources": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "revision",
          "sourceVersion",
          "optional",
          "distribution"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 100
          },
          "revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "sourceVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "optional": {
            "type": "boolean"
          },
          "distribution": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "tag",
              "asset",
              "size",
              "sha256"
            ],
            "properties": {
              "type": {
                "const": "release"
              },
              "tag": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+$",
                "maxLength": 240
              },
              "asset": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+\\.json$",
                "maxLength": 240
              },
              "size": {
                "type": "integer",
                "minimum": 1,
                "maximum": 33554432
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
